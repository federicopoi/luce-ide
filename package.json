{
  "name": "luce-ide",
  "productName": "Luce",
  "version": "0.1.0",
  "description": "A terminal-first workspace for your projects and coding conversations",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "src/main/main.cjs",
  "scripts": {
    "postinstall": "node scripts/prepare-native.mjs",
    "test": "node --test tests/*.test.cjs",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "smoke": "node scripts/smoke.mjs",
    "package": "node scripts/package.mjs",
    "install:app": "node scripts/install.mjs",
    "smoke:recents": "node scripts/recent-smoke.mjs",
    "smoke:accounts": "node scripts/accounts-smoke.mjs",
    "smoke:codex-startup": "node scripts/codex-startup-smoke.mjs",
    "smoke:remote-submit": "node scripts/remote-submit-smoke.cjs",
    "smoke:auto-approval": "node scripts/auto-approval-smoke.mjs",
    "smoke:remote": "node scripts/remote-smoke.mjs",
    "smoke:relay": "node scripts/remote-relay-smoke.mjs",
    "smoke:mobile": "node scripts/remote-mobile-smoke.mjs",
    "smoke:terminal-resize": "node scripts/terminal-resize-smoke.mjs",
    "smoke:sidebar-usage": "node scripts/sidebar-usage-smoke.mjs",
    "smoke:organization": "node scripts/workspace-organization-smoke.mjs",
    "smoke:terminal-links": "node scripts/terminal-links-smoke.mjs",
    "smoke:completion": "node scripts/completion-smoke.mjs",
    "smoke:project-tabs": "node scripts/project-tabs-smoke.mjs",
    "smoke:workspace-resume": "node scripts/workspace-resume-smoke.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "docx-preview": "^0.4.1",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
