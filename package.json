{
  "name": "luce-ide",
  "productName": "Luce",
  "version": "0.1.0",
  "description": "A terminal-first workspace for your projects and coding conversations",
  "private": true,
  "main": "src/main/main.cjs",
  "scripts": {
    "postinstall": "node scripts/prepare-native.mjs",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "smoke": "node scripts/smoke.mjs",
    "package": "node scripts/package.mjs",
    "install:app": "node scripts/install.mjs",
    "smoke:recents": "node scripts/recent-smoke.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
